---
import ProjectCard from "./ProjectCard.astro";
import profile from "../data/profile.json";
import type { Locale } from "../data/site-copy";
import { siteCopy } from "../data/site-copy";
import { getLocalizedProjectPath } from "../utils/locale";

interface ProjectSummary {
  title: string;
  slug: string;
  outcome: string;
  stack: string[];
}

interface Props {
  locale: Locale;
  projects: ProjectSummary[];
}

const { locale, projects } = Astro.props;
const copy = siteCopy[locale].home;
const chromeCopy = siteCopy[locale].chrome;
const mailtoHref = `mailto:${profile.email}?subject=${encodeURIComponent(chromeCopy.ctaSubject)}`;
---

<section class="pt-16 pb-12 space-y-4">
  <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-heading)] leading-tight">
    {profile.name}
  </h1>
  <p class="text-sm uppercase tracking-[0.18em] text-[var(--color-accent)]">
    {copy.companyLine}
  </p>
  <p class="text-lg text-[var(--color-text)]">{copy.tagline}</p>
  <div class="pt-2">
    <a
      href={mailtoHref}
      class="inline-block bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold text-sm py-3 px-8 rounded hover:opacity-90 transition-opacity duration-150"
    >
      {copy.contactCta}
    </a>
  </div>
  <p class="text-sm text-[var(--color-muted)]">
    <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label={chromeCopy.githubAria} class="hover:text-[var(--color-heading)] transition-colors duration-150">GitHub</a>
    <span class="mx-2">&middot;</span>
    <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label={chromeCopy.linkedinAria} class="hover:text-[var(--color-heading)] transition-colors duration-150">LinkedIn</a>
    <span class="mx-2">&middot;</span>
    <a href={mailtoHref} class="hover:text-[var(--color-heading)] transition-colors duration-150">{chromeCopy.emailLabel}</a>
  </p>
</section>

<section class="space-y-4">
  <h2 class="text-2xl font-semibold text-[var(--color-heading)] leading-tight">{copy.aboutHeading}</h2>
  {copy.aboutParagraphs.map((paragraph) => <p class="text-[var(--color-text)]">{paragraph}</p>)}
</section>

<section class="mt-16 space-y-4">
  <h2 class="text-2xl font-semibold text-[var(--color-heading)] leading-tight">{copy.workHeading}</h2>
  <ul class="grid gap-3 md:grid-cols-3">
    {copy.workItems.map((item) => (
      <li class="rounded border border-[var(--color-border)] bg-[var(--color-surface)]/40 p-4">
        <p class="text-sm font-semibold text-[var(--color-heading)]">{item.title}</p>
        <p class="mt-2 text-sm text-[var(--color-text)]">{item.body}</p>
      </li>
    ))}
  </ul>
</section>

<section class="mt-16 space-y-5">
  <h2 class="text-2xl font-semibold text-[var(--color-heading)] leading-tight">{copy.goodFitHeading}</h2>
  <p class="text-[var(--color-text)]">{copy.goodFitIntro}</p>
  <ol class="space-y-5">
    {copy.goodFitItems.map((item, i) => (
      <li class="grid gap-2 border-t border-[var(--color-border)] pt-4 sm:grid-cols-[3.5rem_1fr]">
        <p class="font-mono text-xs leading-5 text-[var(--color-muted)]">{String(i + 1).padStart(2, "0")}</p>
        <div>
          <h3 class="text-base font-semibold text-[var(--color-heading)] leading-tight">{item.title}</h3>
          <p class="mt-1 text-sm text-[var(--color-text)]">{item.body}</p>
        </div>
      </li>
    ))}
  </ol>
  <p class="border-l border-[var(--color-border)] pl-4 text-sm text-[var(--color-muted)]">
    {copy.goodFitAside}
  </p>
</section>

{projects.length > 0 && (
  <section class="mt-16 md:mt-24 space-y-4">
    <h2 class="text-2xl font-semibold text-[var(--color-heading)] leading-tight">{copy.projectsHeading}</h2>
    <div class="space-y-8">
      {projects.map((project, i) => (
        <div style={`--fade-delay: ${i * 100}ms`}>
          <ProjectCard
            title={project.title}
            stack={project.stack}
            outcome={project.outcome}
            href={getLocalizedProjectPath(locale, project.slug)}
          />
        </div>
      ))}
    </div>
  </section>
)}
