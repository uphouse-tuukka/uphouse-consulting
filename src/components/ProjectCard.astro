---
interface Props {
  title: string;
  stack: string[];
  outcome: string;
  href: string;
}

const { title, stack, outcome, href } = Astro.props;
---

<article class="fade-up">
  <a
    href={href}
    class="group block rounded border border-[var(--color-border)] p-4 transition-[border-color,transform] duration-150 hover:border-[var(--color-border-hover)] hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)] md:p-6"
  >
    <h3 class="text-lg font-semibold leading-tight text-[var(--color-heading)] transition-colors duration-150 group-hover:text-[var(--color-accent)]">
      {title}
    </h3>
    <p class="mt-2 text-[var(--color-text)]">{outcome}</p>
    <p class="mt-3 text-[13px] font-mono text-[var(--color-muted)]">
      {stack.map((tech, i) => (
        <>{i > 0 && <span class="text-[var(--color-border)]"> / </span>}{tech}</>
      ))}
    </p>
  </a>
</article>
