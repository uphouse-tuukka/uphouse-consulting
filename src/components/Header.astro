---
import { siteCopy, type Locale } from '../data/site-copy';

interface Props {
  locale: Locale;
  switchHref?: string;
  switchUseAriaLabel?: boolean;
}

const { locale, switchHref, switchUseAriaLabel = true } = Astro.props;
const copy = siteCopy[locale].chrome;
---

<header class="sticky top-0 z-40 bg-[var(--color-bg)] border-b border-[var(--color-border)]">
  <div class="max-w-[720px] mx-auto px-6 py-4 flex items-center justify-between gap-4">
    <a href={locale === "fi" ? "/fi/" : "/"} class="text-[var(--color-heading)] font-semibold text-base hover:text-[var(--color-accent)] transition-colors duration-150">
      UpHouse Consulting
    </a>
    <div class="flex items-center gap-3 md:gap-4">
      {switchHref && (
        <a href={switchHref} aria-label={switchUseAriaLabel ? copy.switchLocaleAria : undefined} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-heading)] transition-colors duration-150">
          {copy.switchLocaleLabel}
        </a>
      )}
      <button
        id="theme-toggle"
        type="button"
        data-light-label={copy.themeLightLabel}
        data-light-aria={copy.themeLightAria}
        data-dark-label={copy.themeDarkLabel}
        data-dark-aria={copy.themeDarkAria}
        aria-label={copy.themeLightAria}
        aria-pressed="true"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)]/70 text-sm text-[var(--color-muted)] hover:text-[var(--color-heading)] hover:border-[var(--color-border-hover)] hover:cursor-pointer transition-colors duration-150 px-3 py-2 min-h-[44px]"
      >
        <span data-theme-toggle-icon aria-hidden="true" class="inline-flex items-center justify-center leading-none">
          <svg
            data-theme-toggle-icon-light
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2.5M12 19.5V22M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12H22M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"></path>
          </svg>
          <svg
            data-theme-toggle-icon-dark
            class="h-4 w-4 hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"></path>
          </svg>
        </span>
        <span data-theme-toggle-label>{copy.themeLightLabel}</span>
      </button>
    </div>
  </div>
</header>
