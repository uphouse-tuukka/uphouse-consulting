---
import profile from "../data/profile.json";
import { siteCopy, type Locale } from "../data/site-copy";
import { getLocalizedHomePath, getLocalizedProjectPath } from "../utils/locale";
import type { CollectionEntry } from "astro:content";

interface ProjectNavLink {
  title: string;
  slug: string;
}

interface Props {
  locale: Locale;
  project: CollectionEntry<"projects"> | CollectionEntry<"projectsFi">;
  prevProject: ProjectNavLink | null;
  nextProject: ProjectNavLink | null;
}

const { locale, project, prevProject, nextProject } = Astro.props;
const { Content } = await project.render();
const copy = siteCopy[locale].projectPage;
const mailtoHref = `mailto:${profile.email}?subject=${encodeURIComponent(siteCopy[locale].chrome.ctaSubject)}`;
---

<section class="pt-16 pb-8 space-y-2">
  <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-heading)] leading-tight">{project.data.title}</h1>
  <p class="text-[var(--color-muted)]">{project.data.role}</p>
  <p class="text-[13px] font-mono text-[var(--color-muted)]">
    {project.data.stack.map((tech: string, i: number) => <>{i > 0 && <span class="text-[var(--color-border)]"> / </span>}{tech}</>)}
  </p>
  <p class="text-sm text-[var(--color-muted)]">{project.data.duration}</p>
  {project.data.demoUrl && (
    <p>
      <a
        href={project.data.demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-sm text-[var(--color-muted)] hover:text-[var(--color-heading)] transition-colors duration-150"
      >
        {copy.demoLinkLabel}
        <span aria-hidden="true">↗</span>
      </a>
    </p>
  )}
</section>

<aside class="mb-10 rounded border border-[var(--color-border)] bg-[var(--color-surface)]/35 p-4 md:p-5" aria-labelledby="at-a-glance-heading">
  <h2 id="at-a-glance-heading" class="text-sm font-semibold text-[var(--color-heading)]">{copy.atAGlanceHeading}</h2>
  <dl class="mt-4 space-y-4">
    <div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-4">
      <dt class="font-mono text-xs uppercase leading-5 text-[var(--color-muted)]">{copy.atAGlanceProblem}</dt>
      <dd class="text-sm leading-5 text-[var(--color-text)]">{project.data.atAGlance.problem}</dd>
    </div>
    <div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-4">
      <dt class="font-mono text-xs uppercase leading-5 text-[var(--color-muted)]">{copy.atAGlanceContribution}</dt>
      <dd class="text-sm leading-5 text-[var(--color-text)]">{project.data.atAGlance.contribution}</dd>
    </div>
    <div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-4">
      <dt class="font-mono text-xs uppercase leading-5 text-[var(--color-muted)]">{copy.atAGlanceResult}</dt>
      <dd class="text-sm leading-5 text-[var(--color-text)]">{project.data.atAGlance.result}</dd>
    </div>
  </dl>
</aside>

<article class="prose prose-neutral max-w-none space-y-4 [&>h2]:text-2xl [&>h2]:font-semibold [&>h2]:text-[var(--color-heading)] [&>h2]:leading-tight [&>h2]:mt-12 [&>h2]:mb-4 [&>p]:text-[var(--color-text)] [&>p]:leading-relaxed [&>ul]:text-[var(--color-text)] [&>ul]:space-y-1 [&>ul]:list-disc [&>ul]:pl-6 [&>li]:text-[var(--color-text)] [&>blockquote]:my-8 [&>blockquote]:rounded [&>blockquote]:border [&>blockquote]:border-[var(--color-border)] [&>blockquote]:border-l-4 [&>blockquote]:border-l-[var(--color-accent)] [&>blockquote]:bg-[var(--color-surface)]/40 [&>blockquote]:px-5 [&>blockquote]:py-4 [&>blockquote]:not-italic [&>blockquote>p]:my-0 [&>blockquote>p+p]:mt-3 [&>blockquote>p:last-child]:text-sm [&>blockquote>p:last-child]:font-medium [&>blockquote>p:last-child]:text-[var(--color-accent)]">
  <Content />
</article>

<section class="mt-16 pt-8 border-t border-[var(--color-border)]">
  <p class="text-lg text-[var(--color-heading)]">{copy.workTogether}</p>
  <div class="mt-4">
    <a href={mailtoHref} class="inline-block bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold text-sm py-3 px-8 rounded hover:opacity-90 transition-opacity duration-150">
      {copy.contactCta}
    </a>
  </div>
</section>

<nav aria-label={copy.navLabel} class="mt-12 pb-8 flex flex-col sm:flex-row sm:justify-between gap-4">
  {prevProject ? <a href={getLocalizedProjectPath(locale, prevProject.slug)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-heading)] transition-colors duration-150">&larr; {prevProject.title}</a> : <span />}
  {nextProject ? <a href={getLocalizedProjectPath(locale, nextProject.slug)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-heading)] transition-colors duration-150 sm:text-right">{nextProject.title} &rarr;</a> : <span />}
</nav>

<p class="pb-8">
  <a href={getLocalizedHomePath(locale)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-heading)] transition-colors duration-150">
    &larr; {copy.backHome}
  </a>
</p>
