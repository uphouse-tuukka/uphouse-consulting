---
import profile from '../data/profile.json';
import { siteCopy, type Locale } from '../data/site-copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = siteCopy[locale].chrome;
const mailtoHref = `mailto:${profile.email}?subject=${encodeURIComponent(profile.ctaSubject)}`;
---

<footer class="border-t border-[var(--color-border)] mt-24">
  <div class="max-w-[720px] mx-auto px-6 py-12 space-y-4">
    <p>
      <a
        href={mailtoHref}
        class="text-[var(--color-accent)] hover:underline"
      >
        {copy.footerCta}
      </a>
    </p>
    <p class="text-sm text-[var(--color-muted)]">
      <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label={copy.githubAria} class="hover:text-[var(--color-heading)] transition-colors duration-150">GitHub</a>
      <span class="mx-2">&middot;</span>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label={copy.linkedinAria} class="hover:text-[var(--color-heading)] transition-colors duration-150">LinkedIn</a>
      <span class="mx-2">&middot;</span>
      <a href={mailtoHref} class="hover:text-[var(--color-heading)] transition-colors duration-150">{copy.emailLabel}</a>
    </p>
    <p class="text-sm text-[var(--color-muted)]">&copy; 2026 {profile.name} / {profile.company}</p>
    <p class="text-sm text-[var(--color-muted)]">{copy.builtWith}</p>
  </div>
</footer>