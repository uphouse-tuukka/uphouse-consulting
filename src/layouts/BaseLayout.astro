---
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { themeInitScript } from '../scripts/theme-init';
import type { Locale } from '../data/site-copy';
import { siteCopy } from '../data/site-copy';
import profile from '../data/profile.json';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  canonicalPath: string;
  switchHref?: string;
  switchUseAriaLabel?: boolean;
}

const { title, description, locale, canonicalPath, switchHref, switchUseAriaLabel = true } = Astro.props;
const copy = siteCopy[locale];
const enPath = locale === 'en' ? canonicalPath : (switchHref ?? canonicalPath);
const fiPath = locale === 'fi' ? canonicalPath : (switchHref ?? canonicalPath);
const pageDescription = description ?? copy.meta.defaultDescription;
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const ogImageUrl = new URL('/og-image.png', Astro.site).toString();
const ogLocale = locale === 'fi' ? 'fi_FI' : 'en_US';
const socialImageAlt = `${profile.name} — ${profile.company}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.company} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {switchHref && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site).toString()} />
        <link rel="alternate" hreflang="fi" href={new URL(fiPath, Astro.site).toString()} />
        <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site).toString()} />
      </>
    )}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script set:html={themeInitScript} />
    <ClientRouter />
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-text)] leading-relaxed">
    <SkipLink label={copy.chrome.skipToContent} />
    <Header locale={locale} switchHref={switchHref} switchUseAriaLabel={switchUseAriaLabel} />
    <main id="main-content" class="max-w-[720px] mx-auto px-6">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import { initThemeToggle } from '../scripts/theme-toggle';
      import { initScrollFade } from '../scripts/scroll-fade';

      initThemeToggle();
      initScrollFade();

      document.addEventListener('astro:after-swap', () => {
        initThemeToggle();
        initScrollFade();
      });
    </script>
  </body>
</html>
