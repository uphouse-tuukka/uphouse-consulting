---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteCopy } from '../data/site-copy';

const copy = siteCopy.en.notFound;
---

<BaseLayout title={copy.title} locale="en" canonicalPath="/404">
  <section class="pt-16 pb-12 space-y-4">
    <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-heading)] leading-tight">
      {copy.title}
    </h1>
    <p class="text-[var(--color-text)]">{copy.body}</p>
    <p>
      <a href="/" class="text-[var(--color-accent)] hover:underline">{copy.backHome}</a>
    </p>
  </section>
</BaseLayout>
