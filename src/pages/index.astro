---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage.astro';
import { getProjectsForLocale, getProjectSlug } from "../utils/projects";
import { siteCopy } from '../data/site-copy';

const locale = 'en' as const;
const copy = siteCopy[locale];
const projects = (await getProjectsForLocale(locale)).map(p => ({
  title: p.data.title,
  slug: getProjectSlug(p),
  outcome: p.data.outcome,
  stack: p.data.stack,
}));
---

<BaseLayout title={copy.meta.homeTitle} description={copy.meta.homeDescription} locale={locale} canonicalPath="/" switchHref="/fi/">
  <HomePage locale={locale} projects={projects} />
</BaseLayout>
