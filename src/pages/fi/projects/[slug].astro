---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectPage from "../../../components/ProjectPage.astro";
import { getProjectsForLocale } from "../../../utils/projects";
import profile from "../../../data/profile.json";

export async function getStaticPaths() {
  const projects = await getProjectsForLocale("fi");
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project, projects } }));
}

const { project, projects } = Astro.props;
const currentIndex = projects.findIndex((p: { slug: string }) => p.slug === project.slug);
const prevProject = currentIndex > 0 ? { title: projects[currentIndex - 1].data.title, slug: projects[currentIndex - 1].slug } : null;
const nextProject = currentIndex < projects.length - 1 ? { title: projects[currentIndex + 1].data.title, slug: projects[currentIndex + 1].slug } : null;
---

<BaseLayout
  title={`${project.data.title} — ${profile.name}`}
  description={project.data.outcome}
  locale="fi"
  canonicalPath={`/fi/projects/${project.slug}`}
  switchHref={`/projects/${project.slug}`}
  switchUseAriaLabel={false}
>
  <ProjectPage locale="fi" project={project} prevProject={prevProject} nextProject={nextProject} />
</BaseLayout>
