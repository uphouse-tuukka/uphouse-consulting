---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteCopy } from '../../data/site-copy';
import { getLocaleFromPathname, getLocalizedHomePath } from '../../utils/locale';

const locale = getLocaleFromPathname(Astro.url.pathname);
const copy = siteCopy[locale].notFound;
const homePath = getLocalizedHomePath(locale);
---

<BaseLayout title={copy.title} locale={locale} canonicalPath="/fi/404">
  <section class="pt-16 pb-12 space-y-4">
    <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-heading)] leading-tight">
      {copy.title}
    </h1>
    <p class="text-[var(--color-text)]">{copy.body}</p>
    <p>
      <a href={homePath} class="text-[var(--color-accent)] hover:underline">{copy.backHome}</a>
    </p>
  </section>
</BaseLayout>
