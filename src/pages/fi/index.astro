---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteCopy } from '../../data/site-copy';

const locale = 'fi' as const;
const copy = siteCopy[locale];
---

<BaseLayout title={copy.meta.homeTitle} description={copy.meta.homeDescription} locale={locale} canonicalPath="/fi/" switchHref="/">
  <section class="pt-16 pb-12 space-y-4">
    <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-heading)] leading-tight">
      Tuukka Ylöstalo
    </h1>
  </section>
</BaseLayout>
