---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectPage from "../../components/ProjectPage.astro";
import { getProjectsForLocale, getLinkedSlug, getAdjacentProjects, getProjectSlug } from "../../utils/projects";
import profile from "../../data/profile.json";

export async function getStaticPaths() {
  const projects = await getProjectsForLocale("en");
  return projects.map((project) => ({ params: { slug: getProjectSlug(project) }, props: { project, projects } }));
}

const { project, projects } = Astro.props;
const { prev: prevProject, next: nextProject } = getAdjacentProjects(projects, project.data.projectKey);
const fiSlug = await getLinkedSlug(project.data.projectKey, "fi");
---

<BaseLayout
  title={`${project.data.title} — ${profile.name}`}
  description={project.data.outcome}
  locale="en"
  canonicalPath={`/projects/${getProjectSlug(project)}`}
  switchHref={fiSlug ? `/fi/projects/${fiSlug}` : "/fi"}
  switchUseAriaLabel={false}
>
  <ProjectPage locale="en" project={project} prevProject={prevProject} nextProject={nextProject} />
</BaseLayout>
